{
  "backend": "component_sim",
  "max_events": 10000,
  "mapping": {
    "tile_m": 32,
    "tile_n": 32,
    "tile_k": 128,
    "dataflow": "output_stationary"
  },
  "backend_config": {
    "architecture": {
      "schema_version": 1,
      "clock_hz": 1000000000.0,
      "components": {
        "dram": {
          "type": "dram",
          "bandwidth_bytes_per_second": 102400000000.0,
          "efficiency": 0.7,
          "latency_cycles": 100,
          "burst_bytes": 64
        },
        "dma": {
          "type": "dma",
          "bytes_per_cycle": 256
        },
        "noc": {
          "type": "link",
          "bytes_per_cycle": 256
        },
        "operand_link": {
          "type": "link",
          "bytes_per_cycle": 256
        },
        "accumulator_link": {
          "type": "link",
          "bytes_per_cycle": 256
        },
        "gb": {
          "type": "sram",
          "capacity_bytes": 4194304,
          "read_bytes_per_cycle": 256,
          "write_bytes_per_cycle": 256
        },
        "local": {
          "type": "sram",
          "capacity_bytes": 131072,
          "read_bytes_per_cycle": 256,
          "write_bytes_per_cycle": 256
        },
        "acc": {
          "type": "sram",
          "capacity_bytes": 65536,
          "read_bytes_per_cycle": 256,
          "write_bytes_per_cycle": 256
        },
        "array": {
          "type": "compute_array",
          "rows": 32,
          "cols": 32,
          "pipeline_cycles": 0,
          "accumulator_bits": 32,
          "supported_formats": [
            "int4",
            "int8",
            "int12",
            "int16",
            "float16",
            "bfloat16",
            "float32",
            "e2m1",
            "e4m3",
            "e4m3fn",
            "e5m2",
            "e5m10"
          ]
        }
      },
      "roles": {
        "dram": "dram",
        "global": "gb",
        "local": "local",
        "accumulator": "acc",
        "array": "array"
      },
      "connections": [
        {
          "from": "dram.data",
          "to": "gb.data",
          "via": "dma"
        },
        {
          "from": "gb.data",
          "to": "dram.data",
          "via": "dma"
        },
        {
          "from": "gb.data",
          "to": "local.data",
          "via": "noc"
        },
        {
          "from": "acc.data",
          "to": "gb.data",
          "via": "noc"
        },
        {
          "from": "local.data",
          "to": "array.data",
          "via": "operand_link"
        },
        {
          "from": "array.data",
          "to": "acc.data",
          "via": "accumulator_link"
        },
        {
          "from": "acc.data",
          "to": "array.data",
          "via": "accumulator_link"
        },
        {
          "from": "gb.data",
          "to": "acc.data",
          "via": "noc"
        }
      ]
    },
    "double_buffer": true,
    "max_plan_events": 200000,
    "save_plan": false
  },
  "mapping_search": {
    "enabled": true,
    "objective": "latency",
    "tile_m_candidates": [
      16,
      32,
      64
    ],
    "tile_n_candidates": [
      16,
      32,
      64
    ],
    "tile_k_candidates": [
      64,
      128,
      256
    ]
  }
}
